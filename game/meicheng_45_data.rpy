    def mc45_weather_next(day, previous):
        if day == 1:
            return "江雾"
        if day == 33:
            return "寒潮"
        if day >= 31:
            pool = ("北风", "寒潮", "霜冻", "多云", "小雨")
        elif day >= 19:
            pool = ("多云", "小雨", "连阴雨", "江雾", "北风")
        else:
            pool = ("晴朗", "多云", "小雨", "江雾", "北风")
        if previous in ("小雨", "连阴雨") and renpy.random.random() < 0.55:
            return renpy.random.choice(("小雨", "连阴雨", "多云"))
        return renpy.random.choice(pool)

    def mc45_pick_location_event(place_id, day, history):
        candidates = list(MC45_LOCATION_EVENTS[place_id])
        recent = set(item[3] for item in history if day - item[0] < 7)
        available = [item for item in candidates if item[0] not in recent]
        if not available:
            available = candidates
        return renpy.random.choice(available)
