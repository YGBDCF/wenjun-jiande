label chapter_2:
    scene bg ch2
    with fade

    centered "{size=50}第二章  江干码头{/size}\n{size=32}把一所大学装上船{/size}"
    pause 0.8

    $ immersive_setup("第二章  江干码头", "1937年11月  杭州", "在潮水变化前完成首批装船", [("核对人员名单", True), ("固定教材与仪器", False), ("按时离岸", False)], ["照顾师生家属", "避免木箱混装"], ["装船清单", "煤油灯"], 1, "tense")
    call immersive_show from _call_immersive_show
    $ ch2_spots = []
    jump ch2_explore_hub

label ch2_story:

    narrator_day1 "1937年11月，师生、家属、图书与仪器陆续集中到江干码头。"
    sy "我从没见过这么多木箱。它们排在江边，像另一支等待出发的队伍。"
    oldzhou "别站在跳板中间。人要过，箱子也要过。"
    sy "老周是船工，说话时总盯着江面。"
    oldzhou "今夜水急，船不能装得太满。重物放中间，怕水的东西要垫高。"
    ls "这批是实验仪器，那批是教材。生活物资在另一边。"
    ct "还有教员家属和孩子。所有人都在问自己坐哪一条船。"
    sy "学校真的能被装进这些船里吗？"
    ls "装不进去。"
    sy "我愣住了。"
    ls "所以才要判断，什么必须先走，什么还能再等一夜。"
    narrator_day1 "码头没有足够的灯，学生举着煤油灯核对箱号。"
    ct "这只箱子写着‘物理’，可清单上记的是化学仪器。"
    sy "先放到待核区，别急着装。"
    oldzhou "再慢，后面的船就赶不上潮水。"
    sy "可装错一箱，到了建德也未必找得回来。"
    oldzhou "你说得对。但江水不会因为你核对得认真就停下来。"
    narrator_day1 "远处忽然传来低沉的警报声，人群出现短暂骚动。"
    ls "不要跑。按小组登船，先让老人和孩子靠里坐。"
    ct "沈砚，我们这组还差三个人。"
    sy "他们去搬最后一批课本了。"
    oldzhou "再等五分钟，必须开船。"
    sy "五分钟里，要把人、书和仪器都安排好。"

    menu:
        "我决定怎样安排第一批船位？"

        "先安置老人、儿童和身体不适者":
            $ day1_trust += 1
            $ day1_morale += 1
            sy "我让出自己的位置，把几名家属带到船舱里面。"
            ct "那你怎么办？"
            sy "我坐下一条船。至少这条船上的人能安心一点。"

        "优先固定精密仪器和教材":
            $ day1_supplies += 2
            sy "我和同学把仪器箱绑在船舱中央，又用油布包住教材。"
            ls "这些东西以后会重新变成实验室和课堂。"
            sy "我忽然明白，我们搬运的并不只是物资，而是未来几个月的教学秩序。"

        "尽可能多装箱子，之后再慢慢核对":
            $ day1_supplies += 1
            $ day1_records -= 1
            oldzhou "箱子是多了，可谁也不知道其中哪几箱该先卸。"
            ls "速度有时必要，但不能把混乱带到下一站。"
            sy "我看着被挤在一起的木箱，第一次意识到‘多装’并不总等于‘做对’。"

    narrator_day1 "最后三名同学在开船前赶到，怀里抱着一摞用绳子捆好的教材。"
    ct "一本没少。"
    oldzhou "坐稳！离岸了。"
    sy "船身轻轻一晃，码头上的灯迅速向后退去。"
    radio "各船沿钱塘江、富春江西行，抵达桐庐后换乘小船。"
    sy "我靠着木箱坐下，手掌还能感到麻绳勒出的痕迹。"
    ct "你说，我们什么时候再回杭州？"
    sy "不知道。"
    ct "你这次终于肯说不知道了。"
    sy "因为我发现，不知道并不可耻。真正可怕的是在不知道的时候，连该做什么都不去想。"
    narrator_day1 "江面没有月光。许多小船在黑暗中排成一条缓慢向西的线。"
    sy "那一夜，一所大学并没有整齐地登上一艘大船。"
    sy "它被分装在人群、书箱、笔记和彼此照应的目光里，一点点离开杭州。"

    $ day1_finish_chapter(2)
    call immersive_hide from _call_immersive_hide
    centered "{size=44}第二章完成{/size}\n护送《四库全书》已解锁"
    jump day1_map_hub
