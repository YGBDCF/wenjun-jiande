label chapter_6:
    scene bg ch6
    with fade

    centered "{size=50}第六章  《浙大日报》{/size}\n{size=32}战争中的信息战{/size}"
    pause 0.8

    $ immersive_setup("第六章  浙江大学日报", "1937年冬  建德", "核实消息并完成今日报纸", [("整理广播信息", True), ("区分事实与传言", False), ("完成排版印刷", False)], ["注明消息来源", "避免放大恐慌"], ["广播记录", "校务布告", "排版稿"], 5, "thoughtful")
    call immersive_show from _call_immersive_show_4
    $ ch6_spots = []
    jump ch6_explore_hub

label ch6_story:

    narrator_day1 "建德缺少稳定的信息来源，学生开始整理广播消息，编辑《浙大日报》。"
    az "今晚必须排完。明早五百张，街上和学校各分一半。"
    sy "广播里的杂音比消息还多。"
    yq "街坊已经传出三种说法：有人说杭州失守，有人说交通全断，还有人说学校马上又要搬。"
    az "所以我们才更不能把听到的都印上去。"
    radio "第一条：已由两个来源确认，前线交通受到影响。"
    radio "第二条：街上传言某地已经失守，暂无来源。"
    radio "第三条：学校明日课程地点调整，有校务布告可核对。"
    sy "第一条有两个来源，第三条有学校布告。第二条只有传言。"
    yq "可第二条最容易让人买报。"
    az "我们卖报不是为了让恐慌跑得更快。"
    yq "可如果最后传言是真的呢？"
    sy "那也应该等证据。报纸一旦印出来，就不再只是一个人随口说的话。"
    az "标题也要谨慎。‘交通受阻’和‘交通断绝’不是一回事。"
    sy "正文里还要注明消息来源。"
    yq "你们写一张报纸，竟像核对一只书箱。"
    sy "其实很像。都要知道一条信息从哪里来，经过谁的手。"
    narrator_day1 "我们把消息写在稿纸上，一条条讨论。"

    menu:
        "头版采用怎样的方案？"

        "刊登第一条和第三条，并明确注明来源":
            $ day1_records += 2
            $ day1_trust += 1
            $ newspaper_choice = "谨慎核实"
            az "慢一点，但读者知道我们为什么相信这些消息。"
            yq "街坊未必喜欢不够惊人的标题。"
            sy "至少他们不会因为我们的标题整夜不敢睡。"

        "三条全部刊登，并加上‘仅供参考’":
            $ day1_records -= 1
            $ newspaper_choice = "信息混杂"
            az "‘仅供参考’不能替我们免除责任。"
            yq "但这样不会漏掉任何可能。"
            sy "也会让确认过的消息和传言看起来一样可靠。"

        "重点刊登第二条，用醒目标题吸引读者":
            $ day1_trust -= 2
            $ day1_records -= 2
            $ newspaper_choice = "追求轰动"
            az "报纸会卖得更快，但造成的恐慌也会更快。"
            yq "一旦证明是假的，街坊以后也不会再信我们。"

    narrator_day1 "标题确定后，我们开始排版。铅字不够，某些常用字需要反复拆换。"
    az "这栏放学校通知，那栏放前线消息。下面留一块给失物招领。"
    sy "报纸还登失物招领？"
    az "当然。迁校以后，丢掉的不只是大事，也有饭票、钥匙和家信。"
    yq "这张纸上，一边是战争，一边是谁捡到了一把伞。"
    az "生活本来就是这样挤在一起的。"
    narrator_day1 "午夜后，第一批报纸终于印出。油墨还没有完全干。"
    sy "纸很薄，字也不算整齐。"
    az "可明早它会被送到五百个人手里。"
    yq "我负责东门街。"
    sy "我去孔庙和林场。"
    az "每张一分钱。工读生可以留下其中一部分作为生活补助。"
    sy "原来一份报纸也能同时承担这么多事情。"
    az "传播消息、维持生活、连接学校和地方。哪一样都不算小。"
    narrator_day1 "清晨，叶青禾在街口卖出第一张报纸。"
    yq "有人先看标题，有人先找学校通知，还有人只想知道亲友所在的路是否还通。"
    sy "我在孔庙门口看见学生把报纸贴到墙上，周围很快围满了人。"
    ct "你们昨晚一夜没睡？"
    sy "差不多。"
    ct "值得吗？"
    sy "如果有人因此少相信一条谣言，多知道一次课程变动，就值得。"
    narrator_day1 "数日后，学校决定继续向西迁移。"
    yq "你们又要走了。"
    sy "是。"
    yq "那《浙大日报》呢？"
    sy "能带走的继续带走。留下的，就留在这里成为这四十五天的记录。"
    yq "你第一次来梅城时，只会说自己不知道下一步。"
    sy "现在我还是不知道更远的路会怎样。"
    yq "但你知道该带走什么。"
    sy "人、书、记录，还有继续上课的理由。"

    scene black
    with fade

    if day1_trust >= 4 and day1_records >= 5:
        centered "{size=52}尾声：共同的记录{/size}\n\n你在选择中维护了人与人之间的信任，也尽力让每条消息和每只书箱都有可靠记录。\n梅城只停留了四十五天，却成为许多人共同记住的一座临时校园。"
    elif day1_records >= 5:
        centered "{size=52}尾声：留下的纸页{/size}\n\n你留下了一份较完整的记录。它不一定能回答所有问题，却让后来的人知道，这所大学如何在混乱中继续运转。"
    elif day1_trust >= 4:
        centered "{size=52}尾声：没有围墙的校园{/size}\n\n你赢得了同学与居民的信任。临时校园并不只由教室组成，也由一次次协商、让步与互相照应组成。"
    else:
        centered "{size=52}尾声：仍在路上{/size}\n\n历史继续向前，而你的记录中仍有空白。那些没有被理解的选择，等待后来的人再次寻找。"

    pause 1.0
    narrator_day1 "1937年12月，浙大师生离开建德，继续西迁。"
    narrator_day1 "四十五天很短，却足以让一座城市成为大学的一部分。"
    narrator_day1 "课堂、书籍、报纸与人的记忆，继续向西。"

    $ day1_finish_chapter(6)
    call immersive_hide from _call_immersive_hide_4

    menu:
        "六章扩写版体验完成。"

        "返回章节地图":
            jump day1_map_hub

        "返回主菜单":
            return
