label chapter_5:
    scene bg ch5
    with fade

    centered "{size=50}第五章  黑板挂在我的胸前{/size}\n{size=32}警报中的课堂{/size}"
    pause 0.8

    $ immersive_setup("第五章  警报中的课堂", "1937年冬  建德", "安全疏散并让课堂继续", [("组织学生疏散", False), ("带回教学材料", False), ("完成临时课堂", False)], ["优先保护人员", "保持队伍秩序"], ["课程笔记", "粉笔", "油灯"], 4, "tense")
    call immersive_show
    $ ch5_spots = []
    jump ch5_explore_hub

label ch5_story:

    narrator_day1 "临时课堂刚开始不久，远处响起防空警报。"
    zs "先合上书。按昨天演练的顺序离开。"
    ct "老师，笔记要带吗？"
    zs "能带就带，不能带先顾人。"
    sy "我把几本教材塞进布包，回头发现后排一名同学还在收拾桌上的纸。"
    sy "别整理了，先走！"
    ct "门口堵住了。"
    zs "不要挤。靠左出去，行动慢的同学在中间。"
    radio "防空警报——各处人员立即疏散——"
    narrator_day1 "街上的人向不同方向移动，雨后的石板路很滑。"
    yq "这边！穿过巷子能到临时避难处。"
    sy "还有两个人没出来。"
    yq "我去看，你先把前面的人带走。"
    sy "不，我和你一起回去。"
    yq "现在不是逞强的时候。你熟悉同学，我熟悉路，各做各的。"
    narrator_day1 "警报让每个人都必须在几秒内判断自己应该做什么。"

    menu:
        "我先做什么？"

        "带行动较慢的同学一起转移":
            $ day1_trust += 1
            $ day1_morale += 1
            sy "我放慢脚步，让队伍不至于把后面的人甩开。"
            ct "你本来可以先走。"
            sy "课堂上点名时，我们是一个班。警报里也一样。"

        "带上课程笔记和粉笔":
            $ day1_records += 1
            sy "我抓起笔记和粉笔，又把桌边的几张作业一并塞进包里。"
            zs "东西不算多，却能让之后的课堂继续。"

        "取走油灯，为避难处照明":
            $ day1_supplies += 1
            sy "我拎起油灯，火苗在奔跑中不断摇晃。"
            yq "到里面再点。别让光暴露位置。"

    narrator_day1 "众人抵达避难处。地方狭窄，没有桌椅，也没有黑板。"
    ct "老师，我们还上课吗？"
    zs "为什么不上？"
    ct "可黑板挂在哪里？"
    zs "可以挂在我的胸前。"
    narrator_day1 "周围短暂地安静了一下，随后有人低声笑了。"
    sy "不是嘲笑，而是一种突然放松下来的笑。"
    zs "既然都坐下了，就把刚才的问题继续做完。"
    ct "在这里？"
    zs "就在这里。条件改变，题目不会自己消失。"

    menu:
        "每船可载180人，540人至少需要几批？"

        "2批":
            $ day1_morale -= 1
            zs "两批只能运走三百六十人。重新算。"
            sy "我在膝盖上的笔记本里改掉答案。"

        "3批":
            $ day1_records += 1
            zs "对。三批正好五百四十人。"
            sy "简单的计算，在此刻却像一种对混乱的抵抗。"

        "4批":
            zs "四批当然能运完，但题目问的是‘至少’。"
            ct "原来在警报里，老师也不会放过一个条件。"

    zs "你们要记住，教育不是等一切安稳以后才开始的事。"
    zs "若总等到条件齐全，我们今天不会在寺院里上课，也不会在梅城继续。"
    sy "油灯的光照在先生胸前那块小黑板上。"
    yq "外面的人都在躲飞机，你们却还在算船次。"
    sy "因为明天也许还要继续搬人、搬书、搬仪器。"
    yq "所以这道题不是为了考试。"
    sy "是为了让我们知道，下一步该怎么做。"
    narrator_day1 "警报解除后，学生们回到临时教室。桌上的纸张被风吹乱，却没有一张被丢下。"
    ct "我以前觉得上课只是每天都会发生的事。"
    sy "现在呢？"
    ct "现在我觉得，每一堂课都是有人努力保住的。"
    sy "我把最后一句写进笔记。"

    $ day1_finish_chapter(5)
    call immersive_hide
    centered "{size=44}第五章完成{/size}\n《浙大日报》已解锁"
    jump day1_map_hub
